{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tokoweb",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "routes": [
    { "pattern": "tokoweb.id/*", "zone_name": "tokoweb.id" },
    { "pattern": "*.tokoweb.id/*", "zone_name": "tokoweb.id" }
  ],
  "triggers": {
    "crons": ["30 17 * * *", "5 17 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tokoweb",
      "database_id": "3b01ad89-4385-4159-b51f-32b572f2ffc5",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "BASE_DOMAIN": "tokoweb.id",
    "CONTACT_WA_NUMBER": "",
    "STORAGE_ENDPOINT": "https://is3.cloudhost.id",
    "STORAGE_BUCKET": "tokoweb",
    "STORAGE_ACCESS_KEY_ID": "KRBFI276VY1VBDSEHDGB",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAEBJvtU7MB77JfRE"
  }
}
